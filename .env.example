# =============================================================================
# Northeastern Journal — environment variables
# -----------------------------------------------------------------------------
# Copy this file to `.env.local` for local development:
#     cp .env.example .env.local
#
# On Vercel, add the same keys under Project Settings → Environment Variables.
# Never commit `.env.local` — it is already in .gitignore.
#
# Full walkthrough for getting each value: docs/SETUP.md
# =============================================================================


# --- Supabase ----------------------------------------------------------------
# Supabase Dashboard → Project Settings → API

# Your project URL, e.g. https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The "anon / public" key. Safe to expose in the browser — Row Level Security
# is what protects the data, not this key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The "service_role" key. SECRET. Bypasses all Row Level Security.
# Server-side only: newsletter signup, unsubscribe, and the scheduled-publish
# cron. Never prefix it with NEXT_PUBLIC_ and never paste it into client code.
SUPABASE_SERVICE_ROLE_KEY=


# --- Resend (email) -----------------------------------------------------------
# Resend Dashboard → API Keys

RESEND_API_KEY=

# Must be on a domain you have verified in Resend → Domains.
# Before verification, Resend will only deliver to your own account address.
NEWSLETTER_FROM="Northeastern Journal <newsletter@northeasternjournal.com>"

# Where replies to newsletters go.
NEWSLETTER_REPLY_TO=editor@northeasternjournal.com

# A real postal address. CAN-SPAM requires one in every commercial email;
# it is printed in the footer of every template.
NEWSLETTER_MAILING_ADDRESS="Northeastern Journal, Northeastern Oklahoma, USA"


# --- Bot protection (optional, recommended) -----------------------------------
# Newsletter signup is single opt-in: an address joins the list the moment it
# is submitted, with no confirmation click to filter out junk. Rate limiting,
# validation, and duplicate detection always run; a captcha is the strongest
# remaining guard. Configure ONE pair.

# Cloudflare Turnstile — dash.cloudflare.com → Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ...or Google reCAPTCHA v3
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# RECAPTCHA_SECRET_KEY=
# RECAPTCHA_MIN_SCORE=0.5


# --- Site ---------------------------------------------------------------------
# Canonical public URL, used to build links inside emails. No trailing slash.
# Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://www.northeasternjournal.com


# --- Scheduled publishing -----------------------------------------------------
# Any long random string. Vercel Cron sends it as a bearer token so nobody
# else can trigger the publish endpoint.
# Generate one with:  openssl rand -hex 32
CRON_SECRET=


# --- Placeholder content (optional) -------------------------------------------
# The site ships with a demo archive so it never looks empty. Real articles
# replace it automatically. These only matter if you want to change that.

# Keep showing demo articles even after real ones exist. Default: false.
# NEXT_PUBLIC_SHOW_DEMO_WITH_REAL_CONTENT=false

# Let search engines index demo articles. Default: false. Leave it off.
# NEXT_PUBLIC_INDEX_DEMO_CONTENT=false
