# Northeastern Journal — environment configuration
# Copy to `.env.local` and fill in what you need. Everything here is
# optional for local development: the site runs with none of it set.

# ---------------------------------------------------------------------
# Dashboard accounts & sessions
# ---------------------------------------------------------------------

# Random string, 16+ characters. Signs admin session cookies and
# unsubscribe tokens. REQUIRED in production.
# Generate one with: openssl rand -base64 32
NJ_AUTH_SECRET=

# Who can sign in at /admin, as a JSON array. `role: "owner"` may edit
# every author profile; `role: "author"` may edit only their own.
# Generate passwordHash with: npm run hash-password -- 'the password'
# With this unset, a development-only account is available locally:
# editor@northeasternjournal.com / northeastern
NJ_ADMIN_ACCOUNTS='[{"email":"nana@northeasternjournal.com","name":"Cherokee Nana","authorSlug":"cherokee-nana","role":"owner","passwordHash":"pbkdf2$210000$...$..."}]'

# ---------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------

# Profile edits, subscribers, and rate-limit counters. With a KV endpoint
# configured they persist across deploys; without one they're written to
# ./.data (fine locally, lost on a serverless host).
# Vercel KV or Upstash Redis both work — either variable pair is read.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Force a driver: redis-rest | file | memory (default: auto-detect)
# NJ_STORE_DRIVER=
# Directory for the file driver (default: .data)
# NJ_DATA_DIR=

# ---------------------------------------------------------------------
# Newsletter (Resend)
# ---------------------------------------------------------------------

# Without a key, signups still work and welcome emails are logged, not sent.
RESEND_API_KEY=
NEWSLETTER_FROM_EMAIL="Northeastern Journal <newsletter@northeasternjournal.com>"
NEWSLETTER_REPLY_TO=
# CAN-SPAM: every issue must carry a valid physical postal address.
NEWSLETTER_POSTAL_ADDRESS="Northeastern Journal, PO Box 000, Your City, ST 00000"
NEWSLETTER_CONTACT_EMAIL="hello@northeasternjournal.com"

# Absolute origin used in unsubscribe links (defaults to siteConfig.url).
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------
# Bot protection — configure ONE of these pairs
# ---------------------------------------------------------------------

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# …or Google reCAPTCHA v3
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# RECAPTCHA_SECRET_KEY=
# RECAPTCHA_MIN_SCORE=0.5

# Reject addresses whose domain has no MX record. Adds a DNS lookup to
# every signup, so it's off by default.
# NJ_VERIFY_MX=true
